{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@kb-rag/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@kb-rag/design-system": [
        "../../packages/design-system/src/index.ts"
      ],
      "@kb-rag/app-shared": [
        "../../packages/app-shared/src/index.ts"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.js",
    "babel.config.js",
    "metro.config.js"
  ],
  "extends": "expo/tsconfig.base"
}

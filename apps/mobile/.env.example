# API 根 URL（勿包含路径末尾 /）。
# - 安卓模拟器访问本机 API：http://10.0.2.2:8788
# - iOS 模拟器访问本机：http://127.0.0.1:8788
# - 禁止在此文件或任何 EXPO_PUBLIC_* 中放置 ARK_API_KEY、方舟密钥或长期服务端密钥
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8788

# 与根目录服务端 HTTP_ADMIN_TOKEN 一致（勿提交含真实密钥的 .env）；仅用于「替换知识库」上传
EXPO_PUBLIC_HTTP_ADMIN_TOKEN=

# 设为 1 时仅渲染 DesignSystemSmoke 验收屏（与 Web 对照截图）
# EXPO_PUBLIC_DS_SMOKE=1

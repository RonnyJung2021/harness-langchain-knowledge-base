# 火山引擎方舟 OpenAI 兼容 API（勿将填好密钥的 .env 提交到 git）
# kb-rag-server 启动时会先加载「仓库根目录」的 .env，再加载当前工作目录下的 .env（后者可覆盖同名变量）；通常只需在仓库根保留一份 .env。
# AI_RUNTIME_MODE=offline 或 RUNTIME_MODE=offline 时下列 ARK_* 可不填（嵌入走离线伪向量，对话见 LOCAL_CHAT_*）；online 时通常为必填（按接入点实际为准）
ARK_API_KEY=
# 推理接入 Base URL，留空则使用默认：https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=
# 对话模型 Endpoint ID（控制台分配的模型 ID）
ARK_CHAT_MODEL=
# 向量 / 嵌入模型 Endpoint ID（多模态向量化如 doubao-embedding-vision-* 为默认路径）
ARK_EMBED_MODEL=
# 嵌入调用模式：留空或 multimodal = POST .../embeddings/multimodal（文本块用 type:text）；text = 标准 .../embeddings
ARK_EMBED_INPUT_MODE=
# 多模态向量维度：1024 或 2048，须与方舟控制台该端点一致
ARK_EMBED_DIMENSIONS=

# RAG 检索：默认 topK=4；ARK_RAG_SCORE_MIN 为余弦相似度下限（越高越相关，默认 0.35）
ARK_RAG_TOP_K=
ARK_RAG_SCORE_MIN=

# 多轮对话上下文裁剪（防止长会话撑爆 token）
# 参与模型调用的最近消息条数：只计 user + assistant，不含本轮用户输入，也不计会话中的 system
ARK_CHAT_MAX_HISTORY_MESSAGES=
# 【参考资料】检索拼接块的总字符上限（默认 12000）；超出则按片段顺序截断并在末尾标记「后略」
ARK_RAG_CONTEXT_MAX_CHARS=

# 会话落盘：设为 1 时，多轮 chat 在每次 append 后写入 sessions/{sessionId}.json（UTF-8）
ARK_SESSION_PERSIST=

# HTTP 服务（v3 L1+）：监听端口，默认 8788（Docker 容器内监听端口与此一致；compose 映射见 KB_RAG_HOST_PORT）
PORT=

# 运行时模式：online（默认，方舟）| offline（离线占位向量 + 可选本地对话，无需方舟）
RUNTIME_MODE=

# AI 运行时模式（优先于 RUNTIME_MODE）：online | offline；未设置时回退到 RUNTIME_MODE；均为 online 时使用方舟嵌入与 ChatOpenAI 兼容路径
AI_RUNTIME_MODE=

# 离线占位嵌入维度：确定性哈希伪向量（非真实语义嵌入，检索效果差，仅本地闭环）；空库首次离线 ingest 时使用（默认 1024）；已有向量时以磁盘向量维度为准
OFFLINE_STUB_EMBED_DIM=

# —— 离线对话（OpenAI 兼容 POST {BASE}/v1/chat/completions，如 Ollama http://127.0.0.1:11434）——
# 留空则使用固定占位答复；配置后若服务不可达，对话返回 503、业务码 OFFLINE_CHAT_UNAVAILABLE
LOCAL_CHAT_BASE_URL=
# 请求体 model 字段（Ollama 示例：llama3.2）；默认 llama3.2
LOCAL_CHAT_MODEL=
# 毫秒；默认 120000
LOCAL_CHAT_TIMEOUT_MS=
# 设为 1 / true：必须配置 LOCAL_CHAT_BASE_URL，禁止仅用占位答复（未配置则对话 503）
LOCAL_CHAT_REQUIRE=

# 【安全】离线模式将 LOCAL_CHAT_BASE_URL 指向本机推理（如 Ollama）时：勿将该端口无防护暴露到公网。
# 若缺乏 TLS、强认证与审计能力，应仅限内网或通过 VPN / 专用 API 网关访问；详见 docs/PRODUCTION_SECURITY_V4.md「4.3」。

# Docker Compose：`docker compose` 读取本文件做变量插值。宿主机与容器默认端口均为 8788；若与本机第二实例并行占用，可另设 KB_RAG_HOST_PORT
KB_RAG_HOST_PORT=

# 浏览器跨域（CORS，Express cors 中间件）：逗号分隔的 Origin 白名单，例如 https://app.example.com,https://staging.example.com
# 留空时：非 production 默认仅允许 http://127.0.0.1:5173（与本机 Vite 开发联调）；production 下不发送 CORS 头（建议 Express 托管 web/dist 同源，或由网关统一配置 CORS）
HTTP_CORS_ORIGINS=

# 位于反向代理后时设为 1：启用 Express trust proxy（首跳），便于限流按真实 IP 统计（须与网关 X-Forwarded-For 配置一致）
HTTP_TRUST_PROXY=

# JSON 路由（express.json）最大 body 字节数，与 KB 上传 KB_UPLOAD_MAX_BYTES 独立；默认 262144（256 KiB）
HTTP_JSON_BODY_MAX_BYTES=

# 对 POST /v1/sessions/:id/messages 与 …/messages:stream 限流（express-rate-limit）；默认关闭，生产建议开启
# 设为 1 / true / yes 启用；HTTP_RATE_LIMIT_BY_SESSION=1 时在限流键上叠加 sessionId（同 IP 多会话互不影响计数）
HTTP_RATE_LIMIT_ENABLED=
HTTP_RATE_LIMIT_WINDOW_MS=
HTTP_RATE_LIMIT_MAX=
HTTP_RATE_LIMIT_BY_SESSION=

# 方舟单次 HTTP 超时（毫秒）：对话、嵌入、多模态 fetch；默认 120000。超时返回 HTTP 504，业务码 ARK_TIMEOUT
ARK_REQUEST_TIMEOUT_MS=

# 访问日志与错误日志级别（pino）：如 debug、info、warn、error；未设置时 production 为 info，否则为 debug
LOG_LEVEL=

# HTTP 单条用户消息最大字符数（POST /v1/sessions/:id/messages 的 body.text），默认 8000
HTTP_CHAT_MAX_MESSAGE_CHARS=

# 替换知识库（POST /v1/knowledge-base/replace）：请求头 Authorization: Bearer <token>，须与本变量完全一致
HTTP_ADMIN_TOKEN=

# multipart 上传 PDF 单文件最大字节数，默认 20971520（20MB）
KB_UPLOAD_MAX_BYTES=

# Playwright：`E2E_SKIP=1` 时不启动 webServer、用例内按需 skip；`E2E_API_PORT` 为 E2E 专用 API 端口（默认 18790）
E2E_SKIP=
E2E_API_PORT=

{
  "name": "kb-rag-local",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @kb-rag/api-core test",
    "test:client-offline": "pnpm --filter @kb-rag/client-offline-core test",
    "gen:offline-golden-fixture": "tsx scripts/gen-offline-golden-fixture.ts",
    "golden:local-retrieve": "tsx scripts/compare-local-retrieve-golden.ts",
    "ingest": "pnpm --filter @kb-rag/api-core run ingest",
    "ingest:smoke": "tsx scripts/ingest-smoke.ts",
    "ingest:core-smoke": "tsx scripts/smoke-ingest-pdf-core.ts",
    "ask": "pnpm --filter @kb-rag/api-core run ask",
    "chat": "pnpm --filter @kb-rag/api-core run chat",
    "serve": "pnpm --filter kb-rag-server run serve",
    "dev:mobile": "pnpm --filter @kb-rag/shared run build && pnpm --filter @kb-rag/design-system run build && pnpm --filter @kb-rag/app-shared run build && pnpm --filter kb-rag-mobile run start",
    "dev:web": "pnpm --filter kb-rag-web dev",
    "build:web": "pnpm --filter kb-rag-web run build",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "clean:kb": "rm -f kb_store/vectors.json kb_store/manifest.json"
  },
  "dependencies": {
    "@kb-rag/api-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
